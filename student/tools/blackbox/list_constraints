#!/usr/bin/env python3
"""list_constraints: list the numeric constraints in SPEC.md and minimal boundary values.

Usage: list_constraints

For each line like `1 <= n <= 100` it prints the minimal values at and next to the lower bound.
Upper bounds are avoided to keep mental math simple and exact.
"""

import re
import sys
from pathlib import Path

NUMBER = r"-?\d+(?:\s*\*\s*10\^\d+|\^\d+)?"
PATTERN = re.compile(rf"({NUMBER})\s*<=?\s*(.+?)\s*<=?\s*({NUMBER})")


def to_int(text: str) -> int:
    """Parse numbers like 100, -1000, 10^5 or 2 * 10^5."""
    text = text.replace(" ", "")
    is_neg = text.startswith("-")
    if is_neg:
        text = text[1:]
    if "*10^" in text:
        base, exp = text.split("*10^")
        val = int(base) * 10 ** int(exp)
    elif "^" in text:
        base, exp = text.split("^")
        val = int(base) ** int(exp)
    else:
        val = int(text)
    return -val if is_neg else val


def main() -> int:
    if "--help" in sys.argv[1:]:
        print(__doc__.strip())
        return 0
    spec_path = Path("SPEC.md")
    if not spec_path.exists():
        print("ERROR: SPEC.md not found.")
        return 1
    spec = spec_path.read_text()
    found = 0
    for line in spec.splitlines():
        match = PATTERN.search(line)
        if not match:
            continue
        low, name, high = to_int(match.group(1)), match.group(2).strip(), to_int(match.group(3))
        found += 1
        if low == high:
            print(f"{name}: [{low}, {high}]  minimal boundaries: {low}")
        elif high <= low + 1:
            print(f"{name}: [{low}, {high}]  minimal boundaries: {low}, {low + 1}")
        else:
            print(f"{name}: [{low}, {high}]  minimal boundaries: {low}, {low + 1} (avoid upper bounds {high} in black-box)")
    if not found:
        print("No numeric constraints found in SPEC.md.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
