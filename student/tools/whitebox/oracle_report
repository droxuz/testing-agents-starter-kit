#!/usr/bin/env python3
"""Run the current suite against the trusted reference; diagnose failures without rewriting.
Usage: oracle_report [--method NAME] [--timeout SECONDS] [--json]
Shows failed test IDs, pytest assertion details, exceptions, and observed target returns.
White-box only. Passing tests are not proof of SPEC-valid inputs or strong assertions.
"""
import json
import sys

from _runtime import common_parser, execute, json_output, prepare, suite_passed


HELP_TEXT = """usage: oracle_report [--method NAME] [--timeout 20] [--json]
Run test suite against solution.py to inspect failure traces and return values.
Shows failed test IDs, pytest assertions, and observed returns."""

def main():
    if "--help" in sys.argv[1:] or "-h" in sys.argv[1:]:
        print(HELP_TEXT)
        return 0
    parser = common_parser(__doc__)
    args = parser.parse_args()
    try:
        root, source, method = prepare(args)
        report = execute(root, source, method, timeout=args.timeout)
        report['tool'] = 'oracle_report'
        report['assertions_rewritten'] = False
        if args.json:
            json_output(report)
        else:
            print(f"Reference execution: {report['status']}; target=Solution.{method}")
            if report['status'] != 'completed':
                print(report.get('detail', 'Execution did not complete.'))
            else:
                failed = [t for t in report['tests'] if t['outcome'] == 'failed']
                print(f"Tests: {len(report['tests'])}; failed: {len(failed)}; observed calls: {report['calls_total']}")
                for error in report.get('collection_errors', [])[:4]:
                    print(f"Collection failure: {error['nodeid']}\n{error['detail']}")
                for test in failed[:4]:
                    print(f"FAIL {test['nodeid']} ({test['calls']} calls)")
                    for phase in test['failures']:
                        print(f"  {phase['phase']}: {phase['detail'][-1000:]}")
                    examples = [e for e in report['call_examples'] if e['nodeid'] == test['nodeid']]
                    for event in examples[:2]:
                        print('  observation: ' + json.dumps(event)[:900])
                if len(failed) > 4:
                    print(f'{len(failed) - 4} additional failures; use --json for the structured report.')
                print('No files rewritten. Review SPEC validity and baseline failures separately.')
        return 0 if suite_passed(report) else 1
    except (ValueError, OSError, SyntaxError) as error:
        parser.exit(2, f'Cannot diagnose oracles: {error}\n')


if __name__ == '__main__':
    sys.exit(main())
