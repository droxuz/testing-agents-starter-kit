#!/usr/bin/env python3
"""mutation_report: test small local mutants in disposable task-local copies.
Usage: mutation_report [--limit 6] [--offset 0] [--line N] [--max-calls 50]
Use --limit 0 to check original outcomes and executed calls without mutants.
JSON: original failures/budget, killed IDs, remaining changes and their status.
Only originally passing tests within budget can kill a mutant.
Timeouts and collection/runner errors are inconclusive, not kills.
Regenerates IDs from unchanged source; rerun after editing tests. No caching.
Uses only task-local solution.py/tests, stdlib and pytest; never benchmark data.
"""
import argparse
import ast
import json
import os
import subprocess
import sys
import tempfile
import time
from collections import Counter
from pathlib import Path

RUNNER = Path(__file__).with_name("_mutation_runner.py").resolve()

SWAPS = {
    ast.Lt: (ast.LtE, ast.Gt), ast.LtE: (ast.Lt, ast.GtE),
    ast.Gt: (ast.GtE, ast.Lt), ast.GtE: (ast.Gt, ast.LtE),
    ast.Eq: (ast.NotEq,), ast.NotEq: (ast.Eq,),
    ast.In: (ast.NotIn,), ast.NotIn: (ast.In,),
    ast.Is: (ast.IsNot,), ast.IsNot: (ast.Is,),
    ast.And: (ast.Or,), ast.Or: (ast.And,),
    ast.Add: (ast.Sub,), ast.Sub: (ast.Add,),
    ast.Mult: (ast.Add,), ast.FloorDiv: (ast.Mod,), ast.Mod: (ast.FloorDiv,),
}


def candidates(tree):
    """Stable IDs identify one operator change, not a benchmark mutant."""
    nodes = sorted((n for n in ast.walk(tree) if isinstance(
        n, (ast.Compare, ast.BoolOp, ast.BinOp, ast.AugAssign))),
        key=lambda n: (n.lineno, n.col_offset))
    number = 0
    for node in nodes:
        operators = node.ops if isinstance(node, ast.Compare) else [node.op]
        for index, operator in enumerate(operators):
            for replacement in SWAPS.get(type(operator), ()):
                number += 1
                yield f"M{number}", node, index, replacement


def change(tree, node, index, replacement):
    """Render a changed copy; always restore the in-memory original."""
    operators = node.ops if isinstance(node, ast.Compare) else [node.op]
    old = operators[index]
    before = ast.unparse(node)
    try:
        if isinstance(node, ast.Compare):
            node.ops[index] = replacement()
        else:
            node.op = replacement()
        after = ast.unparse(node)
        source = ast.unparse(tree) + "\n"
    finally:
        if isinstance(node, ast.Compare):
            node.ops[index] = old
        else:
            node.op = old
    return before, after, source


def run(work, source, selection, timeout):
    (work / "solution.py").write_text(source, encoding="utf-8")
    (work / "_selection.json").write_text(json.dumps(selection), encoding="utf-8")
    output = work / "_outcomes.json"
    output.unlink(missing_ok=True)
    env = os.environ | {"PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1", "PYTEST_ADDOPTS": ""}
    try:
        result = subprocess.run(
            [sys.executable, "-I", "-B", str(RUNNER)], cwd=work,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=timeout, env=env,
        )
    except subprocess.TimeoutExpired:
        return {"status": "timeout"}
    if not output.exists():
        return {"status": "error", "exit_code": result.returncode}
    data = json.loads(output.read_text(encoding="utf-8"))
    data["status"] = ("error" if data["collection_error"]
                      or data["exit_code"] not in (0, 1) else "ok")
    return data


def budget(original, max_calls):
    """Failed tests also spend calls; stop at the first test that cannot fit."""
    used = original["outside_calls"]
    selected = []
    excluded = []
    exhausted = bool(max_calls and used > max_calls)
    for test in original["tests"]:
        exhausted |= bool(max_calls and used + test["calls"] > max_calls)
        if exhausted:
            excluded.append(test["id"])
            continue
        used += test["calls"]
        if test["status"] == "passed":
            selected.append(test["id"])
    return selected, excluded


def report(args):
    root = Path.cwd().resolve()
    source_path = root / "solution.py"
    paths = [source_path, *sorted((root / "tests").glob("test_*.py"))]
    for path in paths:
        if not path.resolve().is_relative_to(root):
            raise ValueError("source and tests must stay inside the task folder")
        if path.stat().st_size > 200_000:
            raise ValueError("each source/test file must be at most 200 KB")
    if len(paths) == 1:
        raise ValueError("write tests/test_*.py before running mutation_report")
    source = source_path.read_text(encoding="utf-8-sig")
    tree = ast.parse(source)
    choices = list(candidates(tree))
    choices = [item for item in choices if args.line is None or item[1].lineno == args.line]
    rows = []
    deadline = time.monotonic() + 90
    with tempfile.TemporaryDirectory(prefix=".mutation-", dir=root) as directory:
        work = Path(directory)
        (work / "tests").mkdir()
        for path in paths[1:]:
            (work / "tests" / path.name).write_bytes(path.read_bytes())
        (work / "pytest.ini").write_text("[pytest]\n", encoding="utf-8")
        original = run(work, source, [], min(15, max(5, args.timeout)))
        if original["status"] != "ok":
            return {"error": "original run " + original["status"],
                    "action": "run run_tests to inspect collection/errors or reduce slow tests"}, 1
        selected, excluded = budget(original, args.max_calls)
        failed = [t["id"] for t in original["tests"] if t["status"] == "failed"]
        total_calls = original["outside_calls"] + sum(t["calls"] for t in original["tests"])
        baseline = {
            "passed": sum(t["status"] == "passed" for t in original["tests"]),
            "failed_count": len(failed), "failed": failed[:8],
            "calls": total_calls, "outside_calls": original["outside_calls"],
            "max_calls": args.max_calls, "tests_over_budget": len(excluded),
            "over_budget": bool(args.max_calls and total_calls > args.max_calls),
            "eligible_tests": len(selected),
        }
        for identity, node, index, replacement in choices[args.offset:args.offset + args.limit] if selected else []:
            before, after, mutated = change(tree, node, index, replacement)
            row = {"id": identity, "line": node.lineno, "column": node.col_offset,
                   "before": before[:160], "after": after[:160]}
            remaining = deadline - time.monotonic()
            if remaining < 1:
                row["status"] = "not_run"
            else:
                outcome = run(work, mutated, selected, min(args.timeout, remaining))
                if outcome["status"] != "ok":
                    row["status"] = outcome["status"]
                else:
                    failures = [t["id"] for t in outcome["tests"] if t["status"] == "failed"]
                    completed = {t["id"] for t in outcome["tests"]}
                    if (set(selected) != completed or any(
                            t["status"] not in ("passed", "failed") for t in outcome["tests"])):
                        row["status"] = "error"
                    else:
                        row["status"] = "killed" if failures else "survived"
            rows.append(row)
    counts = dict(Counter(row["status"] for row in rows))
    data = {
        "baseline": baseline, "available": len(choices), "offset": args.offset, "sampled": len(rows),
        "counts": counts,
        "killed": [r["id"] for r in rows if r["status"] == "killed"],
        "remaining": [r for r in rows if r["status"] != "killed"],
    }
    if not selected and args.limit:
        data["note"] = "No passing tests fit the call budget; no mutants were run."
    data["note"] = data.get("note", "") or "Sampled local mutants; survivors may be equivalent. No achieved MC/DC."
    new_failures = any(not node.startswith("tests/test_blackbox.py::") for node in failed)
    return data, int(baseline["over_budget"] or new_failures)


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--limit", type=int, default=6, help="0-12 sampled mutants; default 6")
    parser.add_argument("--offset", type=int, default=0, help="skip this many candidates; stable IDs")
    parser.add_argument("--line", type=int, help="only mutations on this source line")
    parser.add_argument("--timeout", type=float, default=4, help="seconds per mutant; 0.1-8")
    parser.add_argument("--max-calls", type=int, default=50, help="combined call budget; 0 disables it")
    args = parser.parse_args()
    if not 0 <= args.limit <= 12 or not 0.1 <= args.timeout <= 8 or args.max_calls < 0 or args.offset < 0:
        parser.error("--limit must be 0-12, --timeout 0.1-8, --max-calls/--offset nonnegative")
    if args.line is not None and args.line < 1:
        parser.error("--line must be positive")
    try:
        data, code = report(args)
    except (OSError, SyntaxError, UnicodeError, ValueError, RecursionError) as error:
        data, code = {"error": str(error)}, 1
    print(json.dumps(data, separators=(",", ":")))
    return code


if __name__ == "__main__":
    sys.exit(main())
