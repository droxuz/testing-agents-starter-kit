#!/usr/bin/env python3
"""run_tests: run tests against solution.py.

Usage: run_tests [--whitebox-only] [extra pytest args]

Options:
  --whitebox-only   Run only tests/test_whitebox.py.
"""

import subprocess
import sys

MAX_CHARS = 6000


def main() -> int:
    if "--help" in sys.argv[1:]:
        print(__doc__.strip())
        return 0

    args = sys.argv[1:]
    if "--whitebox-only" in args:
        args = [a for a in args if a != "--whitebox-only"]
        target = ["tests/test_whitebox.py"]
    else:
        target = ["tests"]

    cmd = [sys.executable, "-m", "pytest"] + target + [
        "-q", "--no-header", "-rfE", "--tb=short", "-p", "no:cacheprovider"
    ] + args
    result = subprocess.run(cmd, capture_output=True, text=True, timeout=110)
    output = (result.stdout + result.stderr).strip()
    if len(output) > MAX_CHARS:
        output = "...(output truncated)...\n" + output[-MAX_CHARS:]
    print(output)
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
