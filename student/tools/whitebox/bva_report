#!/usr/bin/env python3
"""bva_report: inspect solution.py for relational mutant sites, structural extremes, and loop 2-iter targets.
Usage: bva_report
Sections: (1) relational MUTANT SITES, (2) structural extremes, (3) loop TWO-ITER & EARLY-EXIT targets."""

import ast
import sys
from pathlib import Path

RELATIONAL_OPS = {"Lt": "<", "LtE": "<=", "Gt": ">", "GtE": ">="}
EQUALITY_OPS = {"Eq": "==", "NotEq": "!=", "In": "in", "NotIn": "not in", "Is": "is", "IsNot": "is not"}
OP_SWAP = {
    "Lt": "<=",
    "LtE": "<",
    "Gt": ">=",
    "GtE": ">",
    "Eq": "!=",
    "NotEq": "==",
    "In": "not in",
    "NotIn": "in",
    "Is": "is not",
    "IsNot": "is",
}


def has_early_exit(loop_node: ast.AST) -> bool:
    nodes = list(loop_node.body + getattr(loop_node, "orelse", []))
    while nodes:
        curr = nodes.pop(0)
        if isinstance(curr, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        if isinstance(curr, (ast.Return, ast.Break)):
            return True
        nodes.extend(ast.iter_child_nodes(curr))
    return False


def main() -> int:
    if "--help" in sys.argv[1:]:
        print(__doc__.strip())
        return 0

    sol_path = Path("solution.py")
    if not sol_path.exists():
        print("ERROR: solution.py not found.")
        return 1

    src = sol_path.read_text(encoding="utf-8", errors="replace")
    try:
        tree = ast.parse(src)
    except SyntaxError as e:
        print(f"ERROR: Cannot parse solution.py: {e}")
        return 1

    lines = src.splitlines()

    comparisons = []
    seen_comps = set()
    constants = []
    seen_consts = set()
    loops = []
    seen_loops = set()

    for node in ast.walk(tree):
        # 1. Relational comparisons (<, <=, >, >=, ==, !=, in, not in, is, is not)
        if isinstance(node, ast.Compare):
            curr_left = node.left
            for op, comp in zip(node.ops, node.comparators):
                op_name = type(op).__name__
                if op_name in RELATIONAL_OPS or op_name in EQUALITY_OPS:
                    left_str = ast.unparse(curr_left)
                    right_str = ast.unparse(comp)
                    col = getattr(curr_left, "col_offset", getattr(node, "col_offset", 0))
                    key = (node.lineno, col, left_str, op_name, right_str)
                    if key not in seen_comps:
                        seen_comps.add(key)
                        line_text = lines[node.lineno - 1].strip() if 0 <= node.lineno - 1 < len(lines) else ""
                        comparisons.append((node.lineno, col, line_text, left_str, op_name, right_str))
                curr_left = comp

        # 2. Integer constants in expressions/conditions (boundary offsets, including negative integers)
        elif isinstance(node, ast.Constant) and type(node.value) is int:
            val = node.value
            if val not in seen_consts and val in (0, 1, 2, -1):
                seen_consts.add(val)
                constants.append(val)
        elif (
            isinstance(node, ast.UnaryOp)
            and isinstance(node.op, ast.USub)
            and isinstance(node.operand, ast.Constant)
            and type(node.operand.value) is int
        ):
            val = -node.operand.value
            if val not in seen_consts and val in (0, 1, 2, -1):
                seen_consts.add(val)
                constants.append(val)

        # 3. Loops (for / while)
        elif isinstance(node, (ast.For, ast.While)) and hasattr(node, "lineno"):
            key = (node.lineno, getattr(node, "col_offset", 0))
            if key not in seen_loops:
                seen_loops.add(key)
                loops.append(node)

    comparisons.sort(key=lambda x: (x[0], x[1]))
    loops.sort(key=lambda n: (n.lineno, getattr(n, "col_offset", 0)))

    print("=== 1. RELATIONAL COMPARISON TARGETS (MUTANT SITES) ===")
    if comparisons:
        for lineno, col, line_text, left, op_name, right in comparisons:
            swap = OP_SWAP.get(op_name, "swap")
            if op_name in RELATIONAL_OPS:
                op_sym = RELATIONAL_OPS[op_name]
                print(f"Line {lineno}: {line_text}")
                print(f'  MUTANT SITE: "{left} {op_sym} {right}" vs "{left} {swap} {right}"')
                print(f"  -> EXACT-TIE:   Make {left} == {right} — the ONLY input that distinguishes {op_sym} from {swap}.")
                if op_name in ("Lt", "LtE"):
                    print(f"  -> JUST-BELOW:  Make {left} = {right} - 1 — both operators agree, confirms base behaviour.\n")
                else:
                    print(f"  -> JUST-ABOVE:  Make {left} = {right} + 1 — both operators agree, confirms base behaviour.\n")
            elif op_name in ("Eq", "NotEq"):
                op_sym = EQUALITY_OPS[op_name]
                print(f"Line {lineno}: {line_text}")
                print(f'  MUTANT SITE: "{left} {op_sym} {right}" vs "{left} {swap} {right}"')
                print(f"  -> EQUALITY:   Test equal case ({left} == {right}).")
                print(f"  -> INEQUALITY: Test not equal case ({left} != {right}).\n")
            elif op_name in ("In", "NotIn"):
                op_sym = EQUALITY_OPS[op_name]
                print(f"Line {lineno}: {line_text}")
                print(f'  MUTANT SITE: "{left} {op_sym} {right}" vs "{left} {swap} {right}"')
                print(f"  -> MEMBERSHIP: Test item present ({left} in {right}) and absent ({left} not in {right}).\n")
            elif op_name in ("Is", "IsNot"):
                op_sym = EQUALITY_OPS[op_name]
                print(f"Line {lineno}: {line_text}")
                print(f'  MUTANT SITE: "{left} {op_sym} {right}" vs "{left} {swap} {right}"')
                print(f"  -> IDENTITY:   Test {left} is {right} and {left} is not {right}.\n")
    else:
        print("No explicit relational comparisons found.\n")

    print("=== 2. STRUCTURAL & GENERAL BOUNDARY TARGETS ===")
    print("  * Minimal Container Size: Test input with len=1 and len=2 (kills loop boundary mutants).")
    print("  * Homogeneous Tie Input: Test container with all identical elements [v, v, v, ...] (kills tie-breaker mutants).")
    if 0 in seen_consts or -1 in seen_consts:
        print("  * Numeric Extremes: Test with 0, negative values (-1), or duplicate maximum elements.")
    print()

    print("=== 3. LOOP BVA TARGETS ===")
    if loops:
        for loop in loops:
            loop_type = "For" if isinstance(loop, ast.For) else "While"
            line_text = lines[loop.lineno - 1].strip() if 0 <= loop.lineno - 1 < len(lines) else ""
            print(f"Line {loop.lineno} [{loop_type}]: {line_text}")
            print("  * TWO-ITER: Write a test where this loop executes exactly 2 times.")
            print("    => Kills off-by-one mutants on the loop bound.")
            if has_early_exit(loop):
                print("  * EARLY-EXIT: Write a test where the loop exits early (return/break triggers before completion).")
                print("    => Kills mutants that remove or misplace the early-exit condition.")
                print("  * FULL-SCAN:  Write a test where the loop runs to completion without early exit.")
                print("    => Kills mutants that always trigger early exit.")
            print()
    else:
        print("No loops found.\n")

    print("Action: For each MUTANT SITE write the EXACT-TIE test first — it is the only input")
    print("that kills the operator mutation. For each loop, write the TWO-ITER test and any")
    print("EARLY-EXIT / FULL-SCAN tests. Place all new tests near the TOP of the test file.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
